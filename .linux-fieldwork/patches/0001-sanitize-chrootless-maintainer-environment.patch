diff --git a/mmdebstrap b/mmdebstrap
--- a/mmdebstrap
+++ b/mmdebstrap
@@ -3902,6 +3902,96 @@ sub run_prepare {
     return \@chrootcmd;
 }
 
+sub chrootless_dpkg_environment() {
+    my @names = qw(
+      PATH
+      DEBIAN_FRONTEND
+      DEBCONF_NONINTERACTIVE_SEEN
+      LC_ALL
+      LANGUAGE
+      LANG
+      TZ
+      SOURCE_DATE_EPOCH
+      QEMU_LD_PREFIX
+    );
+
+    if (defined $ENV{FAKEROOTKEY}) {
+        push @names, qw(FAKEROOTKEY FAKED_MODE FAKEROOT_FD_BASE LD_PRELOAD
+          LD_LIBRARY_PATH);
+    }
+    my @result = ('-i');
+    foreach my $name (@names) {
+        next if !defined $ENV{$name};
+        push @result, "$name=$ENV{$name}";
+    }
+    return @result;
+}
+
+sub chrootless_unsafe_environment() {
+    my %exact = map { $_ => 1 } qw(
+      SSH_AUTH_SOCK
+      SSH_AGENT_PID
+      SSH_ASKPASS
+      GIT_ASKPASS
+      GPG_AGENT_INFO
+      DBUS_SESSION_BUS_ADDRESS
+      XDG_RUNTIME_DIR
+      KRB5CCNAME
+      KRB5_KTNAME
+      KRB5_CLIENT_KTNAME
+      KUBECONFIG
+      DOCKER_CONFIG
+      DOCKER_AUTH_CONFIG
+      REGISTRY_AUTH_FILE
+      NPM_CONFIG_USERCONFIG
+      AWS_ACCESS_KEY_ID
+      AWS_SHARED_CREDENTIALS_FILE
+      AWS_CONFIG_FILE
+      GOOGLE_APPLICATION_CREDENTIALS
+      AZURE_CONFIG_DIR
+      GNUPGHOME
+      NETRC
+    );
+    my $sensitive_name = qr{
+        (?:^|_)
+        (?:
+            TOKEN
+          | SECRET
+          | PASSWORD
+          | PASSWD
+          | CREDENTIALS?
+          | PRIVATE_KEY
+          | API_KEY
+          | ACCESS_KEY
+          | AUTH
+          | JWT
+          | KEYTAB
+        )
+        (?:$|_)
+    }ix;
+    my %unsafe;
+
+    foreach my $name (keys %ENV) {
+        if ($exact{$name} || $name =~ $sensitive_name) {
+            $unsafe{$name} = 1;
+        }
+    }
+    foreach my $name (qw(
+        http_proxy https_proxy ftp_proxy all_proxy
+        HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY
+        PIP_INDEX_URL PIP_EXTRA_INDEX_URL
+        UV_INDEX_URL UV_EXTRA_INDEX_URL
+        )
+    ) {
+        next if !defined $ENV{$name};
+        if ($ENV{$name} =~ m{\A[a-z][a-z0-9+.-]*://[^/\s@]+@}i) {
+            $unsafe{$name} = 1;
+        }
+    }
+    my @unsafe = sort keys %unsafe;
+    return @unsafe;
+}
+
