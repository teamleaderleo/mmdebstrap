+sub chrootless_env_path {
+    my $path = '/usr/bin/env';
+
+    if (!-e $path) {
+        error "chrootless environment wrapper does not exist: $path";
+    }
+    if (!-f $path) {
+        error "chrootless environment wrapper is not a regular file: $path";
+    }
+    if (!-x $path) {
+        error "chrootless environment wrapper is not executable: $path";
+    }
+
+    return $path;
+}
+
